{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    // NodeNext respeta .mjs/.cjs y el tipo del paquete sin cambiar su ejecución.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["paquetes/**/*.js", "paquetes/**/*.d.ts", "cascaras/web/**/*.js", "cascaras/escritorio/**/*.cjs", "cascaras/escritorio/**/*.d.ts", "herramientas/*.mjs", "herramientas/partida/**/*.mjs", "herramientas/laboratorio-vfx/**/*.js", "paquetes/rig/pruebas/*.mjs", "pruebas/todas.mjs", "pruebas/fronteras.mjs"],
  // herramientas/lezer-python es el generador histórico del lector de Python (sus dependencias no se instalan aquí).
  "exclude": ["node_modules", "educational-animation", "herramientas/lezer-python"]
}
