{
  "name": "cmg-anim-remotion",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts AwaitPilot ../../renders/remotion/await-pilot.mp4",
    "render:en": "remotion render src/index.ts AwaitPilotEn ../../renders/remotion/await-pilot-en.mp4",
    "still": "remotion still src/index.ts AwaitPilot ../../renders/remotion/await-pilot-still.png --frame=330",
    "sync-assets": "node scripts/sync-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  }
}
