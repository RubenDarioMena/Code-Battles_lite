  "main": "cascaras/escritorio/main.cjs",
  "productName": "Code Battle Lite",
  "private": true,
  "description": "Juego Code Battle Lite y herramientas de desarrollo, pruebas y telemetría.",
  "dependencies": {
    "@netlify/blobs": "^8.2.0",
    "steamworks.js": "0.4.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "22.20.5",
    "electron": "45.2.1",
    "playwright": "1.65.1",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "paquetes/*"
  ],
  "scripts": {
    "test": "node pruebas/todas.mjs",
